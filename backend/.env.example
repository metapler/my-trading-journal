PORT=3001
DATABASE_URL="postgresql://trading_journal:trading_journal@localhost:5432/trading_journal"
TEST_DATABASE_URL="postgresql://trading_journal:trading_journal@localhost:5432/trading_journal_test"
FRONTEND_URL="http://localhost:5173"
# Session/CSRF signing secret: random string, min 32 chars. REQUIRED in production.
AUTH_SECRET="change-me-to-a-random-32-plus-character-secret"
SESSION_TTL_DAYS=30
# Provider resilience (PLAN §24): per-request timeout and bounded retry attempts.
PROVIDER_TIMEOUT_MS=8000
PROVIDER_MAX_ATTEMPTS=2

DEXSCREENER_BASE_URL="https://api.dexscreener.com"
COINMARKETCAP_BASE_URL="https://pro-api.coinmarketcap.com"
COINMARKETCAP_API_KEY=""
